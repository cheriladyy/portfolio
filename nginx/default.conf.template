server {
    listen 80;
    server_name localhost;

    # Her cevaba, APP_ENV değerini taşıyan bir header ekler
    add_header X-App-Env "${APP_ENV}";

    location / {
        auth_basic "Restricted";
        auth_basic_user_file /etc/nginx/.htpasswd;
        root   /usr/share/nginx/html;
        index  index.html;
    }
}
